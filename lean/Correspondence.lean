import ExplorerTable

/-!
Lean re-proof of `checker-matches-explorer` from residual-evidence-types
`tests/correspondence/Correspondence.agda`: the ported finite checker's
`table`, computed over all 546 configurations, is the table generated from
the explorer (lean/ExplorerTable.lean, generated by
scripts/gen-lean-explorer-table.sh from the Agda `ExplorerTable.agda`).
Checked by kernel reduction (`rfl`).

The two options below only raise the elaborator's own recursion and time
budgets for this one declaration (its definitional-equality check unfolds
all 546 rows); they change nothing the kernel checks or trusts.
-/

namespace MetaManifoldEvidence.Correspondence

open MetaManifoldEvidence.ResidualEvidence.Checker (table)
open MetaManifoldEvidence.ExplorerTable (expected)

set_option maxRecDepth 2000 in
set_option maxHeartbeats 1000000 in
theorem «checker-matches-explorer» : table = expected := rfl

end MetaManifoldEvidence.Correspondence
