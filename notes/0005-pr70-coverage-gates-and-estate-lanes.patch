+#!/usr/bin/env julia
+# SPDX-FileCopyrightText: 2026 Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>
+# SPDX-License-Identifier: AGPL-3.0-or-later
+
+## Check the differential sensitivity evidence
+#
+# `test/unit/test_differential_sensitivity.jl` measures how well the differential
+# methods find a spike-in signal that is known to be there, and writes what it
+# measured to `test/artifacts/differential-sensitivity.json`. This script is the
+# reader that decides whether that file is evidence.
+#
+# The rule it enforces is the one hyperpolymath/proven-tests-and-benches is built
+# around: coverage and provenance are DERIVED from tests that ran and passed,
+# never declared. So the file must exist (a suite that skipped produced no
+# evidence), each claim must carry a measured value and the floor it was held to
+# (a claim without a number is a slogan), the measured value must clear the floor
+# in both directions (the file cannot assert a pass the numbers contradict), and
+# `passed` must be the value the comparisons imply rather than a field somebody
+# wrote.
+#
+# Usage: julia --project=. scripts/ci/check-sensitivity-evidence.jl [path]
+# Exit: 0 when the evidence is complete and consistent; 1 otherwise.
+
+using JSON3
+
+const DEFAULT_PATH = joinpath(@__DIR__, "..", "..", "test", "artifacts",
+                              "differential-sensitivity.json")
+
+# The tiers of proven-tests-and-benches. This lane can only ever produce the
+# middle one: the metrics are demonstrated by a test that ran, never proved.
+const TIERS = ("Actually-Proven", "Provisionally-Proven", "Unproven")
+
+# The claims every method entry must carry.
+const REQUIRED_CLAIMS = ("sensitivity", "specificity", "precision")
+
+function problems_with(path)
+    problems = String[]
+    isfile(path) || return ["$path does not exist: the sensitivity testset did not run, " *
+                            "so there is no evidence to read. A skipped measurement is not a pass."]
+    doc = try
+        JSON3.read(read(path, String))
+    catch err
+        return ["$path is not readable JSON: $(sprint(showerror, err))"]
+    end
+
+    get(doc, :schema_version, nothing) == 1 || push!(problems, "schema_version must be 1")
+    if get(doc, :kind, "") != "differential-sensitivity"
+        push!(problems, "kind must be \"differential-sensitivity\"")
+    end
+    if !haskey(doc, :seed)
+        push!(problems, "the seed is not recorded, so the run is not reproducible")
+    end
+
+    methods = get(doc, :methods, nothing)
+    if !(methods isa JSON3.Object && !isempty(methods))
+        return vcat(problems, "no method produced a measurement")
+    end
+
+    for (method, entry) in pairs(methods)
+        label = String(method)
+        tier = get(entry, :tier, "")
+        tier in TIERS || push!(problems, "$label: tier '$tier' is not one of $(join(TIERS, ", "))")
+        tier == "Actually-Proven" && push!(problems,
+            "$label: claims Actually-Proven, which this lane cannot produce: the metrics come " *
+            "from a test that ran, not from a proof")
+        get(entry, :passed, false) === true ||
+            push!(problems, "$label: passed is not true")
+        claims = get(entry, :claims, nothing)
+        if !(claims isa JSON3.Object)
+            push!(problems, "$label: claims are missing")
+        else
+            for name in REQUIRED_CLAIMS
+                if !haskey(claims, Symbol(name))
+                    push!(problems, "$label: the $name claim is missing")
+                    continue
+                end
+                claim = claims[Symbol(name)]
+                value = get(claim, :value, nothing)
+                floor = get(claim, :floor, nothing)
+                if !(value isa Real && floor isa Real)
+                    push!(problems, "$label/$name: value and floor must both be numbers")
+                elseif !isfinite(value)
+                    push!(problems, "$label/$name: value is not finite")
+                elseif value < floor
+                    push!(problems, "$label/$name: measured $value is below its floor $floor, " *
+                                    "so 'passed' contradicts the measurement")
+                end
+            end
+        end
+        # A method that called nothing has precision 1 and specificity 1 by
+        # construction. The table has to show real calls, or the perfect ratios
+        # are arithmetic, not ability.
+        counts = get(entry, :counts, nothing)
+        counts isa JSON3.Object || push!(problems, "$label: the confusion counts are missing")
+    end
+    problems
+end
+
+function summary(path)
+    doc = JSON3.read(read(path, String))
+    rows = ["| Method | Sensitivity | Specificity | Precision | tp/fp/fn/tn | Tier |",
+            "|---|---|---|---|---|---|"]
+    for (method, entry) in pairs(doc.methods)
+        c = entry.claims
+        n = entry.counts
+        push!(rows, "| `$method` | $(round(c.sensitivity.value; digits=3)) | " *
+                    "$(round(c.specificity.value; digits=3)) | " *
+                    "$(round(c.precision.value; digits=3)) | " *
+                    "$(n.tp)/$(n.fp)/$(n.fn)/$(n.tn) | $(entry.tier) |")
+    end
+    join(rows, "\n")
+end
+
+function main(args)
+    path = isempty(args) ? DEFAULT_PATH : args[1]
+    problems = problems_with(path)
+    if isempty(problems)
+        println("sensitivity evidence: complete and consistent ($(abspath(path)))")
+        println(summary(path))
+        return 0
+    end
+    println(stderr, "sensitivity evidence: $(length(problems)) problem(s) in $path")
+    for p in problems
+        println(stderr, "  - ", p)
+    end
+    return 1
+end
+
+exit(main(ARGS))
