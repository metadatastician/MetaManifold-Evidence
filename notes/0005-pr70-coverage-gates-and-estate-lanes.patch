@@ -0,0 +1,284 @@
+# SPDX-FileCopyrightText: 2026 Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>
+# SPDX-License-Identifier: AGPL-3.0-or-later
+
+# Does the differential analysis find what is there, and only what is there?
+#
+# Every other test in this suite checks that a method computes what it says it
+# computes. None of them can tell a working method from one that calls every
+# taxon significant, or none, because such a method is *consistent*: it matches
+# its own reference implementation exactly. This file is the external check. A
+# community is simulated with a known answer — eight taxa multiplied in the
+# contrast condition, eight divided, eight unchanged — the real analyses are run
+# on it, and the calls are scored:
+#
+#   sensitivity  tp / (tp + fn)   of the sixteen taxa that really differ, how
+#                                 many were called
+#   specificity  tn / (tn + fp)   of the eight that do not differ, how many were
+#                                 left alone
+#   precision    tp / (tp + fp)   1 - the false discovery proportion
+#
+# Two things keep this from being a tautology:
+#
+# * A label-permuted control. The same counts are analysed again with the group
+#   labels shuffled, which destroys every real difference. A method whose
+#   sensitivity survives that is measuring its own threshold, not the data. The
+#   control is the *strong* assertion here; the absolute floors below are
+#   deliberately loose, because they have to hold on any machine, and a loose
+#   floor that a working implementation always meets still fails loudly when a
+#   method starts calling everything or nothing.
+#
+# * The metrics themselves are unit-tested against a table whose scores are
+#   known by hand, above, so a broken counter cannot produce a passing report.
+#
+# The evidence is written to `test/artifacts/differential-sensitivity.json`,
+# with the tier of every claim — Provisionally-Proven, in the sense of
+# hyperpolymath/proven-tests-and-benches: demonstrated by a test that ran and
+# passed, not proved. `passed` is derived from the checks that actually ran, not
+# declared, and `scripts/ci/check-sensitivity-evidence.jl` refuses the file if a
+# claim is missing, unmeasured or failing.
+
+using MetaManifold, Test
+using Random, JSON3
+using MetaManifold.Differential
+
+const _SENSITIVITY_ARTIFACT = joinpath(@__DIR__, "..", "artifacts", "differential-sensitivity.json")
+const _SENSITIVITY_SEED = 20261109
+
+# The claims this file makes, and the floor each one has to clear. Loose on
+# purpose; see the preamble.
+const _SENSITIVITY_FLOORS = Dict(
+    "sensitivity" => 0.625,     # 10 of the 16 taxa that really differ
+    "specificity" => 0.625,     # 5 of 8 unchanged taxa left alone
+    "precision"   => 0.6)
+
+"""
+    _poisson(rng, lambda) -> Int
+
+A Poisson draw by Knuth's method. `exp(-lambda)` underflows for the larger
+means in this simulation, and Poisson variates are additive, so the mean is
+consumed in pieces of at most 20 rather than exponentiated whole.
+"""
+function _poisson_small(rng, lambda::Float64)
+    lambda <= 0 && return 0
+    limit = exp(-lambda)
+    k = 0
+    p = 1.0
+    while true
+        k += 1
+        p *= rand(rng)
+        p <= limit && return k - 1
+    end
+end
+
+function _poisson(rng, lambda::Real)
+    total = 0
+    remaining = Float64(lambda)
+    while remaining > 20
+        total += _poisson_small(rng, 20.0)
+        remaining -= 20
+    end
+    total + _poisson_small(rng, remaining)
+end
+
+"""
+    _simulate(; n_per_group=8, n_up=8, n_down=8, n_null=8, dispersion=5, fold=4.0)
+
+A samples x taxa count matrix with a known answer, drawn from a
+negative-binomial (Gamma-Poisson) community: each taxon has a baseline mean, the
+`n_up` taxa are multiplied by `fold` in the contrast group, the `n_down` taxa are
+divided by it, and the `n_null` taxa are unchanged. `dispersion` is the Gamma
+shape, so the counts are overdispersed exactly as amplicon counts are.
+
+Returns `(counts, samples, taxa, groups, truth)` where `truth[taxon]` is `1` for
+up, `-1` for down and `0` for unchanged.
+"""
+function _simulate(; n_per_group::Int=8, n_up::Int=8, n_down::Int=8, n_null::Int=8,
+                   dispersion::Int=5, fold::Float64=4.0)
+    rng = MersenneTwister(_SENSITIVITY_SEED)
+    n_taxa = n_up + n_down + n_null
+    taxa = ["taxon_$(lpad(j, 3, '0'))" for j in 1:n_taxa]
+    truth = Dict{String,Int}()
+    for (j, taxon) in enumerate(taxa)
+        truth[taxon] = j <= n_up ? 1 : (j <= n_up + n_down ? -1 : 0)
+    end
+    # Baseline means spanning two orders of magnitude, so neither the rare nor
+    # the abundant end of the table is the only one tested.
+    baseline = [20.0 * 1.18^(j - 1) for j in 1:n_taxa]
+    groups = vcat(fill("control", n_per_group), fill("treated", n_per_group))
+    samples = ["s$(i)" for i in eachindex(groups)]
+    counts = Matrix{Int}(undef, length(samples), n_taxa)
+    for i in eachindex(samples)
+        treated = groups[i] == "treated"
+        for j in 1:n_taxa
+            mu = baseline[j]
+            treated && truth[taxa[j]] == 1 && (mu *= fold)
+            treated && truth[taxa[j]] == -1 && (mu /= fold)
+            # Gamma(shape=dispersion, scale=mu/dispersion), exactly, as the sum
+            # of `dispersion` exponentials; then Poisson, giving the
+            # negative-binomial marginal.
+            lambda = (mu / dispersion) * sum(randexp(rng, dispersion))
+            counts[i, j] = _poisson(rng, lambda)
+        end
+    end
+    (counts, samples, taxa, groups, truth)
+end
+
+"""
+    _classification_metrics(result, truth; alpha=0.05) -> NamedTuple
+
+tp, fp, fn, tn and the three ratios for one analysis, counting a taxon as
+called when its BH-adjusted p-value is below `alpha`. A taxon with no adjusted
+p-value (filtered, or a structural decision) is not called.
+"""
+function _classification_metrics(result, truth; alpha::Real=0.05)
+    called = Set{String}()
+    for row in result["rows"]
+        p = row["padj"]
+        (isnothing(p) || p >= alpha) && continue
+        push!(called, String(row["taxon"]))
+    end
+    tp = fp = fn = tn = 0
+    for (taxon, direction) in truth
+        if direction == 0
+            taxon in called ? (fp += 1) : (tn += 1)
+        else
+            taxon in called ? (tp += 1) : (fn += 1)
+        end
+    end
+    sensitivity = tp + fn == 0 ? NaN : tp / (tp + fn)
+    specificity = tn + fp == 0 ? NaN : tn / (tn + fp)
+    precision = tp + fp == 0 ? 1.0 : tp / (tp + fp)
+    (tp=tp, fp=fp, fn=fn, tn=tn, sensitivity=sensitivity,
+     specificity=specificity, precision=precision, n_called=length(called))
+end
+
+@testset "Differential sensitivity and specificity" begin
+    # First the counter itself: a table whose scores are known by hand.
+    hand = Dict(
+        "status" => "ok",
+        "rows" => [Dict{String,Any}("taxon" => "up1",   "padj" => 0.001),
+                   Dict{String,Any}("taxon" => "up2",   "padj" => 0.2),
+                   Dict{String,Any}("taxon" => "null1", "padj" => 0.04),
+                   Dict{String,Any}("taxon" => "null2", "padj" => nothing)])
+    hand_truth = Dict("up1" => 1, "up2" => 1, "null1" => 0, "null2" => 0)
+    m = _classification_metrics(hand, hand_truth)
+    @test (m.tp, m.fp, m.fn, m.tn) == (1, 1, 1, 1)
+    @test m.sensitivity == 0.5
+    @test m.specificity == 0.5
+    @test m.precision == 0.5
+    @test m.n_called == 2
+
+    counts, samples, taxa, groups, truth = _simulate()
+    @test size(counts) == (16, 24)
+    @test all(>=(0), counts)
+    @test count(==(1), values(truth)) == 8
+    @test count(==(-1), values(truth)) == 8
+    @test count(==(0), values(truth)) == 8
+
+    # HAVE_MASS and HAVE_ZCOMP are established by test_differential.jl, which
+    # runs first. Naming this file alone must not crash on their absence.
+    _have_mass = @isdefined(HAVE_MASS) ? HAVE_MASS : false
+    _have_zcomp = @isdefined(HAVE_ZCOMP) ? HAVE_ZCOMP : false
+    methods = String[]
+    _have_mass && push!(methods, "nb_glm")
+    _have_zcomp && push!(methods, "clr_welch")
+
+    claims = Dict{String,Any}()
+    if isempty(methods)
+        @info "R, MASS or zCompositions unavailable - the sensitivity measurement is SKIPPED"
+        @test_skip false
+    else
+        # The same input with the labels shuffled destroys every real
+        # difference. Any sensitivity left is the threshold talking.
+        order = Random.shuffle(MersenneTwister(_SENSITIVITY_SEED + 1),
+                               collect(eachindex(groups)))
+        permuted_groups = groups[order]
+
+        for method in methods
+            config = DifferentialConfig(; method)
+            actual = differential_abundance(counts, samples, taxa, groups;
+                reference="control", contrast="treated", config)
+            control = differential_abundance(counts, samples, taxa, permuted_groups;
+                reference="control", contrast="treated", config)
+            a = _classification_metrics(actual, truth)
+            c = _classification_metrics(control, truth)
+
+            @test a.tp + a.fp + a.fn + a.tn == length(truth)
+            @test a.sensitivity >= _SENSITIVITY_FLOORS["sensitivity"]
+            @test a.specificity >= _SENSITIVITY_FLOORS["specificity"]
+            @test a.precision >= _SENSITIVITY_FLOORS["precision"]
+            # The control is the assertion that matters: permuted labels cannot
+            # find more of the truth than the real labels do.
+            @test c.sensitivity <= a.sensitivity
+            @test c.sensitivity <= 0.25
+
+            claims[method] = Dict{String,Any}(
+                "tier" => "Provisionally-Proven",
+                "tier_basis" => "a test that ran and passed; no proof",
+                "claims" => Dict{String,Any}(
+                    "sensitivity" => Dict("value" => a.sensitivity,
+                                          "floor" => _SENSITIVITY_FLOORS["sensitivity"]),
+                    "specificity" => Dict("value" => a.specificity,
+                                          "floor" => _SENSITIVITY_FLOORS["specificity"]),
+                    "precision" => Dict("value" => a.precision,
+                                        "floor" => _SENSITIVITY_FLOORS["precision"])),
+                "counts" => Dict("tp" => a.tp, "fp" => a.fp,
+                                 "fn" => a.fn, "tn" => a.tn),
+                "control" => Dict("sensitivity" => c.sensitivity,
+                                  "specificity" => c.specificity,
+                                  "precision" => c.precision,
+                                  "tp" => c.tp, "fp" => c.fp),
+                "passed" => a.sensitivity >= _SENSITIVITY_FLOORS["sensitivity"] &&
+                            a.specificity >= _SENSITIVITY_FLOORS["specificity"] &&
+                            a.precision >= _SENSITIVITY_FLOORS["precision"] &&
+                            c.sensitivity <= a.sensitivity &&
+                            c.sensitivity <= 0.25)
+        end
+
+        if compositional_da_available()
+            config = DifferentialConfig(; method="aldex2", mc_samples=64, seed=7)
+            actual = differential_abundance(counts, samples, taxa, groups;
+                reference="control", contrast="treated", config)
+            a = _classification_metrics(actual, truth)
+            @test a.sensitivity >= _SENSITIVITY_FLOORS["sensitivity"]
+            @test a.specificity >= _SENSITIVITY_FLOORS["specificity"]
+            claims["aldex2"] = Dict{String,Any}(
+                "tier" => "Provisionally-Proven",
+                "tier_basis" => "a test that ran and passed; no proof",
+                "claims" => Dict{String,Any}(
+                    "sensitivity" => Dict("value" => a.sensitivity,
+                                          "floor" => _SENSITIVITY_FLOORS["sensitivity"]),
+                    "specificity" => Dict("value" => a.specificity,
+                                          "floor" => _SENSITIVITY_FLOORS["specificity"]),
+                    "precision" => Dict("value" => a.precision,
+                                        "floor" => _SENSITIVITY_FLOORS["precision"])),
+                "counts" => Dict("tp" => a.tp, "fp" => a.fp,
+                                 "fn" => a.fn, "tn" => a.tn),
+                "passed" => a.sensitivity >= _SENSITIVITY_FLOORS["sensitivity"] &&
+                            a.specificity >= _SENSITIVITY_FLOORS["specificity"] &&
+                            a.precision >= _SENSITIVITY_FLOORS["precision"])
+        end
+
+        # Written only now, from what ran: every entry above is the record of an
+        # analysis that was actually executed in this session.
+        mkpath(dirname(_SENSITIVITY_ARTIFACT))
+        open(_SENSITIVITY_ARTIFACT, "w") do io
+            JSON3.pretty(io, Dict{String,Any}(
+                "schema_version" => 1,
+                "kind" => "differential-sensitivity",
+                "seed" => _SENSITIVITY_SEED,
+                "alpha" => 0.05,
+                "design" => Dict("samples_per_group" => 8, "n_up" => 8,
+                                 "n_down" => 8, "n_null" => 8,
+                                 "fold" => 4.0, "dispersion" => 5),
+                "floors" => _SENSITIVITY_FLOORS,
+                "provenance" => Dict("provided_by" => "test/unit/test_differential_sensitivity.jl",
+                                     "derived_from" => "the analyses this file ran",
+                                     "not_claimed" => "that the methods are calibrated; " *
+                                                      "the floors are loose and the control " *
+                                                      "is the strong assertion"),
+                "methods" => claims))
+        end
+        @test isfile(_SENSITIVITY_ARTIFACT)
+    end
+end
