+## K9 and DEED conformance
+#
+# Two estate formats, two lanes, one file, because they are adopted together and
+# reviewed together:
+#
+#   * DEED — the repository deed (`<repo>_chora.deed`) that states what this
+#     repository is, who maintains it and under which terms. The canon's own
+#     linter checks it against the grammar.
+#   * K9 — the contracts under `.machine_readable/contractiles/` that state what
+#     the repository's configuration must satisfy, typechecked rather than
+#     eyeballed.
+#
+# Both are called from the canon at one pinned commit rather than reimplemented
+# here: `hyperpolymath/standards` is the owner spelling the Actions resolver has
+# accepted in this estate, and the pons-asinorum record of 2026-10-25 shows what
+# the other spelling costs (a reusable refused at job setup produces
+# `startup_failure`, no job and no log, so nothing is red and nothing explains
+# why). The `@9bdf864c` pin is a commit at which both reusable files exist; that
+# was checked against the API rather than assumed.
+#
+# WHY `require-files` IS FALSE FOR NOW
+# ------------------------------------
+# This repository carries no `.deed` and no `.k9` yet. With `require-files:
+# false` a lane with no corpus is grey rather than red, and the moment a file
+# appears it is validated — which is the property worth having today. Setting it
+# to true would fail every push until somebody manufactures a manifest to
+# satisfy the gate, and a manifest written to satisfy a validator is exactly how
+# a conformance lane stops meaning anything. The change that flips these to true
+# is the change that adds the deed and the contracts, and it should carry no
+# other subject.
+#
+# This file adds no required status check: the required contexts are unchanged,
+# and these two lanes are informational until the corpus exists.
+
+name: K9 and DEED conformance
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  deed:
+    name: DEED conformance
+    uses: hyperpolymath/standards/.github/workflows/deed-conformance.yml@9bdf864cc7f2c8e24b4df84bf00d04158eee3ad5
+    permissions:
+      contents: read
+    with:
+      require-files: false
+
+  k9:
+    name: K9 contract conformance
+    uses: hyperpolymath/standards/.github/workflows/k9-conformance.yml@9bdf864cc7f2c8e24b4df84bf00d04158eee3ad5
+    # The callee's grid job reads `contents: read` and `pull-requests: read`
+    # (the latter to read its own previous grid comment as the delta baseline).
+    # A caller that grants less is refused at startup, with no job to explain it.
+    permissions:
+      contents: read
+      pull-requests: read
+    with:
+      require-files: false
+      # An orange grid is a real state, not a pass: with `false` only red fails,
+      # and orange is reported. Flipped together with `require-files` when the
+      # corpus exists.
+      fail-on-indeterminate: false
+      grid-author: github-actions[bot]
