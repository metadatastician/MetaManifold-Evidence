+#!/usr/bin/env bash
+# SPDX-FileCopyrightText: 2026 Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>
+# SPDX-License-Identifier: AGPL-3.0-or-later
+#
+# Test sensitivity: does the differential suite actually constrain the code?
+#
+# Adapted from `scripts/mutants.sh` and `scripts/julia-mutants.sh` in
+# hyperpolymath/MetaManifold-Evidence (AGPL-3.0-or-later), which hold the same
+# line for the Agda proofs and the Julia certificate table: a mutant is a
+# deliberate, plausible corruption of the code under test, and a suite that
+# still passes with it in place is not testing that behaviour. Coverage counts
+# lines that ran; this counts lines that would be *noticed* if they were wrong.
+# The two answer different questions and the estate has been bitten by treating
+# the first as the second.
+#
+# Every mutant below has a named catcher in
+# `test/unit/test_differential_native.jl`, and none of them needs R: the native
+# adapter is exercised through the stand-in backend, so this gate runs in the
+# same job as the suite without a second environment.
+#
+# The invariant, stated so that it cannot drift into a bypass: a mutant survives
+# only if the suite is blind to it. It is never "the suite is green, so pass" —
+# the unmutated baseline runs first and must pass, or nothing below is
+# meaningful.
+#
+# Usage: bash scripts/ci/mutants-differential.sh [--list]
+# Exit: 0 when every mutant is killed and the baseline passes; 1 otherwise.
+
+set -euo pipefail
+cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.."
+
+julia_bin="${JULIA:-julia}"
+target="src/analysis/differential.jl"
+tests="differential_native"
+
+if [ "${1:-}" = "--list" ]; then
+  printf '%s\n' \
+    'bh-not-suppressed' 'estimate-from-wrong-column' 'log2-uses-log10' \
+    'structural-decisions-ignored' 'contrast-direction-reversed' \
+    'seam-bypassed' 'one-taxon-floor' 'composition-error-swallowed' \
+    'package-name-hardcoded' 'nonfinite-published'
+  exit 0
+fi
+
+work="$(mktemp -d)"
+backup="$work/differential.jl"
+cp "$target" "$backup"
+restore() { cp "$backup" "$target"; }
+trap 'restore; rm -rf "$work"' EXIT
+
+echo "baseline: the unmutated suite must pass, or a survivor means nothing"
+if ! "$julia_bin" --project=. test/runtests.jl "$tests" >"$work/baseline.log" 2>&1; then
+  echo "ERROR: the baseline suite fails, so mutation results cannot be interpreted" >&2
+  tail -40 "$work/baseline.log" >&2
+  exit 1
+fi
+echo "PASS: baseline is green"
+
+# Apply one sed expression to the target and require that the copy changed and
+# that the focused suite fails. A mutant that dies of a syntax error is not a
+# kill: it proves the parser works, not the tests.
+kill_mutant() {
+  local label=$1 expr=$2
+  restore
+  sed -i -e "$expr" "$target"
+  if cmp -s "$backup" "$target"; then
+    echo "ERROR: mutant $label did not change $target (stale pattern)" >&2
+    exit 1
+  fi
+  if "$julia_bin" --project=. test/runtests.jl "$tests" >"$work/$label.log" 2>&1; then
+    echo "ERROR: mutant survived: $label - the suite does not constrain this behaviour" >&2
+    tail -20 "$work/$label.log" >&2
+    exit 1
+  fi
+  if grep -qE 'syntax:|ParseError|ERROR: LoadError' "$work/$label.log"; then
+    cat "$work/$label.log" >&2
+    echo "ERROR: mutant $label failed to load, so it was never tested" >&2
+    exit 1
+  fi
+  echo "PASS: killed $label"
+}
+
+# Applying BH a second time to ALDEx2's expected p-values.
+kill_mutant bh-not-suppressed 's@^    if !native_adjustment$@    if true@'
+# Reporting the within-instance effect where the between-condition difference belongs.
+kill_mutant estimate-from-wrong-column 's@^                "estimate" => aldex ? f.diff_btw : f.effect,$@                "estimate" => f.effect,@'
+# Converting natural-log effects with the wrong base.
+kill_mutant log2-uses-log10 's@^                "log2_fold_change" => aldex ? nothing : f.effect / log(2),$@                "log2_fold_change" => aldex ? nothing : f.effect / log(10),@'
+# Publishing a table of numbers for taxa the model declared structurally absent.
+kill_mutant structural-decisions-ignored 's@^            if config.method == "ancombc" \&\& f.status != "tested"$@            if false@'
+# Swapping the contrast direction, so a positive effect means less abundant.
+kill_mutant contrast-direction-reversed 's@^        native_groups = \[g == reference ? "0" : "1" for g in groups\]$@        native_groups = [g == reference ? "1" : "0" for g in groups]@'
+# Checking the package instead of the backend that will actually be called.
+kill_mutant seam-bypassed 's@^        _native_methods_available(config.method, backend)$@        _native_methods_available(config.method)@'
+# Letting a single retained taxon through to a two-group composition.
+kill_mutant one-taxon-floor 's@^        length(tested) >= 2 ||@        length(tested) >= 1 ||@'
+# Rethrowing the package's refusal instead of reporting it as one.
+kill_mutant composition-error-swallowed 's@^            _is_composition_error(backend, e) \&\& error(sprint(showerror, e))$@            false \&\& error(sprint(showerror, e))@'
+# Recording the package's name when a stand-in produced the numbers.
+kill_mutant package-name-hardcoded 's@^        diagnostics\["native_method"\] = Dict("package" => string(nameof(backend)),$@        diagnostics["native_method"] = Dict("package" => "CompositionalDA",@'
+# Publishing a NaN statistic rather than refusing to report one.
+kill_mutant nonfinite-published 's@^            isfinite(f.effect) \&\& isfinite(f.pvalue) \&\& isfinite(f.qvalue) ||$@            true ||@'
+
+echo "PASS: every mutant was killed by the differential native suite"
