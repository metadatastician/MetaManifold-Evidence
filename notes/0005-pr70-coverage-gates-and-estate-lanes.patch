+# SPDX-FileCopyrightText: 2026 Joshua Benjamin Jewell
+# SPDX-FileCopyrightText: 2026 Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>
+# SPDX-License-Identifier: MPL-2.0
+
+## CI/CD squabbler
+#
+# The estate's CI/CD fighter, run inside the gate set rather than beside it.
+#
+# WHY THIS REPOSITORY NEEDS IT
+# ----------------------------
+# This repository has already paid for the failure the squabbler exists to
+# catch, and the invoice is in `ci.yml`: a required status check whose name
+# GitHub does not post verbatim is a check that never reports, and a pull request
+# can then be merged only by bypassing the rule. The comment on the `test` job
+# records the measurement (a 1x1 matrix still embedded its values in the check
+# name, `Julia tests (1.12.5, ubuntu-24.04)`, so the required context `Julia
+# tests` was simply absent), and `test/unit/test_install_pins.jl` now asserts the
+# rule over every job in `ci.yml`.
+#
+# `squabble chains` is the general case of that test: it maps reusable-workflow
+# and action edges across repositories, so a dead upstream or a dependency cycle
+# is found while the board still reads green. Exit 4 (cycle or dead upstream)
+# fails the job. Exit 2 (the tool could not look) fails too, deliberately: a gate
+# that cannot look must not pass.
+#
+# The `fight-report` half is advisory and always will be here. It classifies a
+# pull request's reds, and when it runs it fails only if the tool itself fails;
+# "the planner proposed a move" is information for a human, not a verdict on a
+# pull request. It never passes `--apply` and never writes to the repository —
+# enacting a move is a reviewed commit, not a workflow's decision.
+#
+# The squabble binary is installed by the upstream composite action at a pinned
+# commit inside the reusable, and that action refuses any binary whose sha256 and
+# build attestation do not match its pinned release. Nothing here downloads a
+# tool by name and trusts it.
+#
+# This file adds no required status check.
+
+name: CI/CD Squabbler
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  pull-requests: read
+  attestations: read
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  squabble:
+    name: Squabble this pull request's gate
+    uses: hyperpolymath/standards/.github/workflows/cicd-squabbler-reusable.yml@9bdf864cc7f2c8e24b4df84bf00d04158eee3ad5
+    # The callee's jobs read `contents`, `pull-requests` and `attestations`;
+    # granting less is refused at startup with no check run to explain it.
+    permissions:
+      contents: read
+      pull-requests: read
+      attestations: read
+    with:
+      # Empty on push and schedule runs, which skips the advisory fight report;
+      # on a pull request it is the number the report is about.
+      pr-number: ${{ github.event.pull_request.number || '' }}
+    # No `ADMINISTRATION_READ_TOKEN`: without a credential that can read this
+    # repository's classic branch protection, `fight` says NOT RUN in those words
+    # instead of guessing. Supplying one is a separate decision, with a separate
+    # credential, and the hard `chains` gate runs either way.
