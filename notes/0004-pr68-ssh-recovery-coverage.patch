+    @testset "a durable cancel request is honoured before a receipt is reused" begin
+        _remote_fixture() do f
+            command = d -> "cd '$d' && cat input > output"
+            f.invoke(command)
+            journal = _journal(f)
+            journal["cancel_requested"] = true
